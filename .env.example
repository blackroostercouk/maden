# Enquiry delivery (https://resend.com). Copy to .env.local and fill in.
# Without these, development writes enquiries to .data/enquiries.ndjson
# and production rejects them with an error in the server log.
RESEND_API_KEY=
# Where enquiries are sent. Comma-separate several addresses.
ENQUIRY_TO_EMAIL=
# Sender, on a domain verified in Resend, e.g. "Moden <enquiries@yourdomain.com>"
ENQUIRY_FROM_EMAIL=
